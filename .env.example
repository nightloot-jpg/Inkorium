# APP_URL: The URL where this applet is hosted.
APP_URL="https://www.inkorium.es"

# --- SUPABASE CONFIGURATION ---
VITE_SUPABASE_URL="https://zllwzmfsfzfedorljgtg.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# --- HETZNER OBJECT STORAGE (S3 COMPATIBLE) ---
# These variables are required by the Express server running on Hetzner/Coolify.
HETZNER_S3_ENDPOINT="https://fsn1.your-objectstorage.com"
HETZNER_S3_REGION="fsn1"
HETZNER_S3_ACCESS_KEY_ID="your-hetzner-access-key"
HETZNER_S3_SECRET_ACCESS_KEY="your-hetzner-secret-key"
HETZNER_S3_BUCKET="inkorium-media"
# Public URL of the bucket, if configured. Example: https://<bucket>.fsn1.<provider-domain>
HETZNER_S3_PUBLIC_URL="https://your-public-bucket-url"

# --- OPTIONAL CLIENT PUBLIC URL ---
VITE_STORAGE_PUBLIC_URL=""
